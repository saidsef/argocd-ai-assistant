{
    "name": "argocd-ai-assistant",
    "version": "0.0.0",
    "main": "index.js",
    "license": "MIT",
    "peerDependencies": {
        "react": ">=16.14.0",
        "react-dom": ">=16.14.0"
    },
    "scripts": {
        "build": "yarn clean && NODE_ENV=production yarn ts-node node_modules/.bin/webpack",
        "build-dev": "yarn clean && yarn ts-node node_modules/.bin/webpack",
        "package": "yarn build && tar -C dist -cvf dist/extension-$npm_package_name-${VERSION:-$npm_package_version}.tar resources",
        "package-dev": "yarn build-dev && tar -C dist -cvf dist/extension-$npm_package_name-${VERSION:-$npm_package_version}.tar resources",
        "clean": "rm -rf dist",
        "clean-all": "rm -rf dist && rm -rf node_modules",
        "build-docs": "podman run --rm -v .:/docs docker.io/squidfunk/mkdocs-material:9 build",
        "clean-docs": "rm -rf site",
        "version": "node -p \"require('./package.json').version\"",
        "set-version": "npm version --no-git-tag-version"
    },
    "devDependencies": {
        "@types/node": "^25.8.0",
        "@types/react": "^19.2.14",
        "css-loader": "^7.1.4",
        "raw-loader": "^4.0.2",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "sass": "^1.99.0",
        "sass-loader": "^17.0.0",
        "style-loader": "^4.0.0",
        "ts-loader": "^9.5.7",
        "ts-node": "^10.9.2"
    },
    "resolutions": {
        "fast-uri": "^3.1.2"
    },
    "dependencies": {
        "dompurify": "^3.4.3",
        "marked": "^18.0.3",
        "typescript": "^6.0.3",
        "webpack": "^5.106.2",
        "webpack-cli": "^7.0.2"
    }
}
