{
    "name": "argocd-ai-assistant",
    "version": "0.0.0",
    "main": "index.js",
    "license": "MIT",
    "peerDependencies": {
        "react": ">=16.14.0",
        "react-dom": ">=16.14.0"
    },
    "scripts": {
        "build": "yarn clean && yarn typecheck && NODE_ENV=production webpack",
        "build-dev": "yarn clean && yarn typecheck && webpack",
        "typecheck": "tsc --noEmit",
        "package": "yarn build && COPYFILE_DISABLE=1 tar -C dist -cvf dist/extension-$npm_package_name-${VERSION:-$npm_package_version}.tar resources",
        "package-dev": "yarn build-dev && COPYFILE_DISABLE=1 tar -C dist -cvf dist/extension-$npm_package_name-${VERSION:-$npm_package_version}.tar resources",
        "clean": "rm -rf dist",
        "clean-all": "rm -rf dist && rm -rf node_modules",
        "build-docs": "podman run --rm -v .:/docs docker.io/squidfunk/mkdocs-material:9 build",
        "clean-docs": "rm -rf site",
        "version": "node -p \"require('./package.json').version\"",
        "set-version": "npm version --no-git-tag-version"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "css-loader": "^7.1.4",
        "esbuild-loader": "^4.5.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "style-loader": "^4.0.0",
        "typescript": "^7.0.2",
        "webpack": "^5.109.0",
        "webpack-cli": "^7.2.1"
    },
    "resolutions": {
        "fast-uri": "^3.1.4"
    },
    "dependencies": {
        "dompurify": "^3.4.12",
        "marked": "^18.0.7"
    }
}
