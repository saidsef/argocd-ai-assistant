{
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "es2020",
        "jsx": "react",
        "allowJs": true,
        "strict": false,
        "noUnusedLocals": true,
        "types": ["node"],
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
